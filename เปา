-- ระบบกด เปิด / หยุด เพลงสลับกัน
local MarketplaceService = game:GetService("MarketplaceService")
local toolEvent = game:GetService("ReplicatedStorage"):WaitForChild("RE"):WaitForChild("PlayerToolEvent")
local isPlaying = false

button.MouseButton1Click:Connect(function()
    playClickSound()
    local rawText = textBox.Text
    if rawText ~= "" and rawText ~= "ช่องใส่เพลง" then
        if not isPlaying then
            -- สถานะ: กดเปิด
            isPlaying = true
            button.Text = "หยุด"
            
            -- ดึงเฉพาะไอดีเพลงหลังเลข "00"
            local cleanSongId = rawText
            local foundIndex = rawText:find("00")
            if foundIndex then
                cleanSongId = rawText:sub(foundIndex + 2)
            end
            
            local finalPayload = cleanSongId .. generateJunkSuffix()
            local numericId = tonumber(cleanSongId)
            
            -- ส่งข้อมูลเปิดเพลง
            local args = {
                "ToolMusicText",
                finalPayload,
                [4] = true
            }
            toolEvent:FireServer(unpack(args))
            
            if numericId then
                task.spawn(function()
                    local success, info = pcall(function()
                        return MarketplaceService:GetProductInfo(numericId)
                    end)
                    if success and info and info.Name then
                        songNameLabel.Text = "🎶 กำลังเล่น: " .. info.Name
                    else
                        songNameLabel.Text = "🎶 กำลังเล่น: (ไม่พบชื่อเพลง)"
                    end
                end)
            else
                songNameLabel.Text = "🎶 กำลังเล่น: ส่งไอดีสำเร็จ"
            end
        else
            -- สถานะ: กดหยุด
            isPlaying = false
            button.Text = "เปิด"
            songNameLabel.Text = "🎶 กำลังเล่น: -"
            
            -- ส่งข้อมูลหยุดเพลง (ค่าว่าง) ตามที่คุณต้องการ
            local args = {
                "ToolMusicText",
                "",
                [4] = true
            }
            pcall(function()
                toolEvent:FireServer(unpack(args))
            end)
        end
    end
end)

