task.spawn(function()
    while screenGui and screenGui.Parent do
        for i = 0, 1, 0.05 do
            if not screenGui or not screenGui.Parent then break end
            stroke.Color = Color3.fromRGB(255, 255, 255):Lerp(Color3.fromRGB(0, 0, 0), i)
            toggleBtn.BackgroundColor3 = stroke.Color
            task.wait(0.05)
        end
        for i = 0, 1, 0.05 do
            if not screenGui or not screenGui.Parent then break end
            stroke.Color = Color3.fromRGB(0, 0, 0):Lerp(Color3.fromRGB(255, 255, 255), i)
            toggleBtn.BackgroundColor3 = stroke.Color
            task.wait(0.05)
        end
    end
end)

