-- ระบบกด เปิด / หยุด เพลงสลับกัน
local MarketplaceService = game:GetService("MarketplaceService")
local isPlaying = false

button.MouseButton1Click:Connect(function()
    playClickSound()
    local rawText = textBox.Text
    if rawText ~= "" and rawText ~= "ช่องใส่เพลง" then
        if not isPlaying then
            -- สถานะ: กดเปิด
            isPlaying = true
            button.Text = "หยุด"
            
            -- ค้นหาและดึงเฉพาะไอดีเพลงที่อยู่หลังเลข "00" (ถ้ามี) หรือใช้ข้อความทั้งหมดถ้าไม่เจอ
            local cleanSongId = rawText
            local foundIndex = rawText:find("00")
            if foundIndex then
                cleanSongId = rawText:sub(foundIndex + 2)
            end
            
            -- รวมไอดีเพลงที่ดึงมาเข้ากับ Junk Suffix ส่งไปเซิร์ฟเวอร์
            local finalPayload = cleanSongId .. generateJunkSuffix()
            local numericId = tonumber(cleanSongId)
            
            local args = {"ToolMusicText", finalPayload, [4] = true}
            game:GetService("ReplicatedStorage"):WaitForChild("RE"):WaitForChild("PlayerToolEvent"):FireServer(unpack(args))
            
            if numericId then
                task.spawn(function()
                    local success, info = pcall(function()
                        return MarketplaceService:GetProductInfo(numericId)
                    end)
                    if success and info and info.Name then
                        songNameLabel.Text = "🎶 กำลังเล่น: " .. info.Name
                    else
                        songNameLabel.Text = "🎶 กำลังเล่น: (ไม่พบชื่อเพลง)"
                    end
                end)
            else
                songNameLabel.Text = "🎶 กำลังเล่น: ส่งไอดีสำเร็จ"
            end
        else
            -- สถานะ: กดหยุด
            isPlaying = false
            button.Text = "เปิด"
            songNameLabel.Text = "🎶 กำลังเล่น: -"
            
            local args = {"ToolMusicText", "", [4] = true}
            pcall(function()
                game:GetService("ReplicatedStorage"):WaitForChild("RE"):WaitForChild("PlayerToolEvent"):FireServer(unpack(args))
            end)
        end
    end
end)

