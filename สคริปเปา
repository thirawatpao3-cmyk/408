-- ระบบลากแถบ Volume
local uis = game:GetService("UserInputService")
local currentVolume = 1
local dragging = false

sliderBg.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
    end
end)

uis.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

uis.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local mousePos = input.Position.X
        local bgPos = sliderBg.AbsolutePosition.X
        local bgSize = sliderBg.AbsoluteSize.X
        local relativeX = math.clamp(mousePos - bgPos, 0, bgSize)
        
        local scale = relativeX / bgSize
        sliderFill.Size = UDim2.new(scale, 0, 1, 0)
        currentVolume = math.floor(scale * 100)
        volLabel.Text = "🔊 ระดับเสียง: " .. currentVolume .. "%"
        
        pcall(function()
            local args = {"ToolMusicVolume", currentVolume / 100, [4] = true}
            game:GetService("ReplicatedStorage"):WaitForChild("RE"):WaitForChild("PlayerToolEvent"):FireServer(unpack(args))
        end)
    end
end)

