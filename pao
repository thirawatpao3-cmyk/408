-- 6. ฟังก์ชันถอดรหัส Sound ID ตามเงื่อนไข[span_2](start_span)[span_2](end_span)[span_3](start_span)[span_3](end_span)
local function extractRealId(obfuscatedSoundId)
    local lastEncodedId = nil
    for encodedDigits in obfuscatedSoundId:gmatch("&%%%%69%%%%64=([%%%%0-9A-Fa-f]+)") do[span_4](start_span)[span_4](end_span)[span_5](start_span)[span_5](end_span)
        lastEncodedId = encodedDigits[span_6](start_span)[span_6](end_span)
    end
    if not lastEncodedId then return nil end

    local decoded = lastEncodedId:gsub("%%(%x%x)", function(hex)
        return string.char(tonumber(hex, 16))
    end)
    return decoded:match("^0*(%d+)$")[span_7](start_span)[span_7](end_span)
end

-- 7. ระบบค้นหาเสียงในตัวละคร
local function getPlayingSounds(plr)
    local sounds = {}
    if plr.Character then
        for _, obj in ipairs(plr.Character:GetDescendants()) do
            if obj:IsA("Sound") and (obj.IsPlaying or obj.TimePosition > 0) then
                table.insert(sounds, obj)
            end
        end
    end
    return sounds
end

-- 8. ระบบอัปเดตรายชื่อคนเปิดเพลง
local function updatePlayerList()
    for _, child in ipairs(playerListFrame:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    local count = 0
    for _, plr in ipairs(Players:GetPlayers()) do
        local sounds = getPlayingSounds(plr)
        if #sounds > 0 then
            count = count + 1
            local btn = Instance.new("TextButton")
            btn.Size = UDim2.new(1, 0, 0, 32)
            btn.BackgroundColor3 = Color3.fromRGB(38, 42, 54)
            btn.TextColor3 = Color3.fromRGB(255, 255, 255)
            btn.Text = "🔊 " .. plr.DisplayName .. " (@" .. plr.Name .. ")"
            btn.TextSize = 12
            btn.Font = Enum.Font.Gotham
            btn.Parent = playerListFrame

            local bCorner = Instance.new("UICorner")
            bCorner.CornerRadius = UDim.new(0, 6)
            bCorner.Parent = btn

            btn.MouseButton1Click:Connect(function()
                local rawSound = sounds[1]
                local rawId = rawSound and rawSound.SoundId or ""
                local decodedId = extractRealId(rawId)

                if decodedId then
                    idDisplayBox.Text = decodedId
                    statusLabel.Text = "ผู้เล่น: " .. plr.Name .. "\nถอดรหัสสำเร็จ!"
                    statusLabel.TextColor3 = Color3.fromRGB(140, 220, 160)
                    if pcall(function() return setclipboard end) and setclipboard then
                        setclipboard(decodedId)
                        statusLabel.Text = statusLabel.Text .. " (คัดลอกลงคลิปบอร์ดแล้ว)"
                    end
                else
                    idDisplayBox.Text = ""
                    statusLabel.Text = "ผู้เล่น: " .. plr.Name .. "\nRaw ID: " .. rawId .. "\n(ไม่พบข้อความที่เข้ารหัสตามเงื่อนไข)"
                    statusLabel.TextColor3 = Color3.fromRGB(240, 140, 140)
                end
            end)
        end
    end

    if count == 0 and idDisplayBox.Text == "" then
        statusLabel.Text = "กำลังรอผู้เล่นเปิดเพลง..."
        statusLabel.TextColor3 = Color3.fromRGB(180, 180, 190)
    end
end

